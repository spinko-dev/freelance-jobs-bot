# Копируйте этот файл в .env и заполните своими значениями.

# Токен бота (получить у @BotFather -> /newbot)
BOT_TOKEN=1234567890:AAAA...

# Публичные каналы-источники (через запятую), веб-версия t.me/s/<name>
SOURCE_CHATS=@channel1, @channel2

# Прокси (http://user:pass@host:port или socks5://...). Пусто = без прокси.
PROXY_URL=

# Интервал опроса веб-версии каналов, сек
WEB_POLL_INTERVAL=60

# Ваш Telegram ID (ограничивает доступ к боту; можно оставить пустым)
OWNER_ID=

# Интервал проверки очереди вакансий, сек
QUEUE_POLL_INTERVAL=5

# Необязательно: ключи для parser.py (прослушивание групповых чатов, Telethon)
# https://my.telegram.org -> API development tools
API_ID=
API_HASH=
SESSION_NAME=user_session
